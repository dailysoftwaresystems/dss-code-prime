ROW l2b2split_n05_file_auto_T
  rules: 
  model S_RedeclaredSymbol E @31:32 actual='T' is already declared in this scope, so its type cannot be inferred from an initializer here scopes=[]
  model S_AutoRequiresInitializer E @31:32 actual=initializer-inferred declaration requires an initializer (there is no type to infer from): T scopes=[]
  lowering: not run (model errors)
ROW l2b2split_n05_block_auto_T
  rules: declOrAttrStmtx1 typeNameEmptyDeclx1 
  lower S_DeclarationDeclaresNothing W @462:469 actual=auto T; scopes=[]
  lowering: ok
ROW l2b2split_n05_for_auto_T
