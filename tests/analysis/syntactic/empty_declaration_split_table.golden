  lower S_DeclarationDeclaresNothing W @467:473 actual=auto T scopes=[]
  lowering: ok
ROW l2b2split_n06_file_register_T
  rules: 
  parse P_NoAlternativeMatched E @26:34 actual='register' scopes=[]
  lower H_UnsupportedLoweringForKind E @446:454 actual=top-level construct '<token>' is not lowered (no hirLowering mapping) scopes=[]
  lowering: failed
ROW l2b2split_n06_block_register_T
