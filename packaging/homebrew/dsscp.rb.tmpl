# Homebrew formula for the dsscp compiler (macOS + Linux tap).
# Rendered by packaging/render.py from the release assets on each publish.
#
# This is a BINARY formula: it downloads the per-OS/arch release tarball, which
# is a PREFIX TREE produced by `cmake --install` (bin/, lib/, share/) — see
# cmake/DssInstall.cmake, the single owner of what ships. Still depends on the
# queued dss-code-prime -> dsscp binary rename.
class @CLASSNAME@ < Formula
  desc "@DESCRIPTION@"
  homepage "@HOMEPAGE@"
  version "@VERSION@"
  license "@LICENSE@"

  on_macos do
    on_arm do
      url "@URL_MACOS_ARM64@"
      sha256 "@SHA256_MACOS_ARM64@"
    end
  end

  on_linux do
    on_intel do
      url "@URL_LINUX_X64@"
      sha256 "@SHA256_LINUX_X64@"
    end
    on_arm do
      url "@URL_LINUX_ARM64@"
      sha256 "@SHA256_LINUX_ARM64@"
    end
  end

  def install
    # The tarball has SEVERAL top-level entries (bin/, lib/, share/), so Homebrew
    # does NOT strip a leading directory — paths here are the prefix tree itself.
    # Installed WHOLE into the keg, deliberately: `dsscp` locates its config tree
    # by a path RELATIVE TO ITS OWN EXECUTABLE (`../share/dss-code-prime/<version>/
    # dss-config`), and its rpath finds the shared library the same way
    # (@loader_path/../lib on macOS, $ORIGIN/../lib on Linux). Cherry-picking the
    # exe and the lib would break both hops, and the compiler would then be unable
    # to resolve `#include <stdio.h>`. Homebrew symlinks bin/dsscp into its own
    # bin; the resolver follows symlinks to the real keg path, so the relative hop
    # still lands inside the keg.
    prefix.install Dir["*"]
  end

  test do
    # Compile something REAL. `--version`/`--help` would pass on a keg with no
    # config tree at all, which is exactly the breakage this formula shipped
    # before the install set existed; resolving `#include <stdio.h>` cannot.
    (testpath/"hello.c").write <<~C
      #include <stdio.h>
      int main(void) { printf("ok\\n"); return 42; }
    C
    spec = if OS.mac?
      Hardware::CPU.arm? ? "arm64:macho64-arm64-darwin-exec" : "x86_64:macho64-x86_64-darwin-exec"
    else
      Hardware::CPU.arm? ? "arm64:elf64-aarch64-linux-exec" : "x86_64:elf64-x86_64-linux-exec"
    end
    system bin/"dsscp", "--compile", "hello.c", "--language", "c",
                        "--target", spec, "--output", testpath
  end
end
